{
  "name": "obsidian-speed-reader",
  "version": "1.3.2",
  "description": "Speed read your notes using Spritz-style RSVP with Optimal Recognition Point (ORP), smart pacing, chunking, and text-to-speech.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test tests/*.test.ts tests/*.test.mjs",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "speed-reading",
    "rsvp",
    "spritz",
    "bionic-reading"
  ],
  "author": "Bathert",
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bathert/obsidian-speed-reader.git"
  },
  "bugs": {
    "url": "https://github.com/Bathert/obsidian-speed-reader/issues"
  },
  "homepage": "https://github.com/Bathert/obsidian-speed-reader#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "moment": "^2.31.0"
  }
}
